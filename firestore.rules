rules_version = '2';

// Regras do banco de dados dos usuários do PocketDex (site e app).
// Cole no Console do Firebase → Firestore Database → Regras → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Chave do nome ("Ásh  Ketchum" → "ash ketchum"), igual à do site e do app.
    function keyOf(name) {
      return name.lower()
        .replace('[áàâãä]', 'a').replace('[éèêë]', 'e').replace('[íìîï]', 'i')
        .replace('[óòôõö]', 'o').replace('[úùûü]', 'u').replace('ç', 'c').replace('ñ', 'n')
        .replace(' +', ' ');
    }

    // Nome da conta (o mesmo que aparece nos rankings).
    function accountName(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.name;
    }

    // Só dá para usar como nome um nome reservado para si em usernames.
    function nameIsMine(uid) {
      let d = request.resource.data;
      return !('name' in d)
        || (resource != null && resource.data.get('name', null) == d.name)
        || ('nameKey' in d
          && getAfter(/databases/$(database)/documents/usernames/$(d.nameKey)).data.uid == uid
          && getAfter(/databases/$(database)/documents/usernames/$(d.nameKey)).data.name == d.name);
    }

    function validAvatar(d) {
      return !('avatar' in d) || d.avatar == null || d.avatar is int;
    }

    // Linha de ranking: só a própria pessoa, com o nome da conta dela.
    function validScore(uid, max) {
      let d = request.resource.data;
      return signedIn(uid)
        && d.keys().hasOnly(['name', 'score', 'avatar', 'correct', 'seconds', 'updatedAt'])
        && d.score is int && d.score > 0 && d.score <= max
        && validAvatar(d)
        && d.name == accountName(uid);
    }

    // Perfil e dados (favoritos, times, treinos...) de cada pessoa:
    // só ela mesma pode ler e escrever.
    match /users/{uid} {
      allow read, delete: if signedIn(uid);
      allow create, update: if signedIn(uid) && nameIsMine(uid);
    }

    // Amigos: friends/{dono}/list/{outro} = {name, avatar, status, since, challenge?}
    //   status: 'sent' (pedido enviado), 'received' (pedido recebido), 'friends'.
    // Quem pede grava dos dois lados ('sent' no seu, 'received' no do outro);
    // quem recebeu aceita e os dois viram 'friends'. Qualquer um desfaz
    // (apaga os dois). Amigos podem deixar um desafio (challenge) um para o outro.
    match /friends/{owner}/list/{other} {
      function validFriend(d) {
        return d.keys().hasOnly(['name', 'avatar', 'status', 'since', 'challenge'])
          && d.name is string && d.name.size() <= 20
          && (!('avatar' in d) || d.avatar == null || d.avatar is int)
          && d.status in ['sent', 'received', 'friends']
          && (!('challenge' in d) || d.challenge == null
              || (d.challenge is map && d.challenge.keys().hasOnly(['code', 'score', 'at'])
                  && d.challenge.code is string && d.challenge.code.size() <= 300));
      }
      allow read: if signedIn(owner);
      allow delete: if signedIn(owner) || signedIn(other);
      // O dono: manda um pedido (com o nome real do outro), aceita um
      // recebido, ou atualiza a própria lista sem mudar o estado.
      allow create: if signedIn(owner) && owner != other && validFriend(request.resource.data)
        && request.resource.data.status == 'sent' && request.resource.data.name == accountName(other);
      allow update: if signedIn(owner) && validFriend(request.resource.data)
        && ((resource.data.status == 'received' && request.resource.data.status == 'friends')
            || request.resource.data.status == resource.data.status);
      // O outro: o pedido dele chega aqui ('received', com o nome dele), ele
      // aceita deste lado, ou (já amigos) manda um desafio / atualiza o nome.
      allow create: if signedIn(other) && owner != other && validFriend(request.resource.data)
        && request.resource.data.status == 'received' && request.resource.data.name == accountName(other);
      allow update: if signedIn(other) && validFriend(request.resource.data)
        && request.resource.data.name == accountName(other)
        && request.resource.data.status == 'friends'
        && resource.data.status in ['sent', 'friends'];
    }

    // Confirmações por link no e-mail (contas Google): quando a pessoa abriu
    // o link para criar a conta, trocar a senha ou excluir. Só ela vê e muda.
    match /confirmations/{uid} {
      allow read, delete: if signedIn(uid);
      allow create, update: if signedIn(uid)
        && request.resource.data.keys().hasOnly(['signup', 'password', 'delete']);
    }

    // Ranking geral do Ranked: todos os logados veem.
    match /ranking/{uid} {
      allow read: if request.auth != null;
      allow create, update: if validScore(uid, 5000);
      allow delete: if signedIn(uid);
    }

    // Ranking da semana ({week} = segunda-feira, "AAAA-MM-DD"): só sobe.
    match /weekly/{week}/scores/{uid} {
      allow read: if request.auth != null;
      allow create: if validScore(uid, 5000);
      allow update: if validScore(uid, 5000) && request.resource.data.score >= resource.data.score;
      allow delete: if signedIn(uid);
    }

    // Desafio do dia ({day} = "AAAA-MM-DD"): uma tentativa por dia.
    match /daily/{day}/scores/{uid} {
      allow read: if request.auth != null;
      allow create: if validScore(uid, 11000)
        && request.resource.data.correct is int
        && request.resource.data.correct >= 0 && request.resource.data.correct <= 10;
      allow delete: if signedIn(uid);
    }

    // Times públicos: todo time de quem tem conta aparece para todos os
    // logados (busca pelo nome do dono). Só o dono cria, muda e apaga; a nota
    // da comunidade (soma e quantidade de estrelas) só muda junto com o voto.
    match /publicTeams/{teamId} {
      function team() { return request.resource.data; }
      function ratingPath() {
        return /databases/$(database)/documents/publicTeams/$(teamId)/ratings/$(request.auth.uid);
      }
      function reportPath() {
        return /databases/$(database)/documents/publicTeams/$(teamId)/reports/$(request.auth.uid);
      }
      function reports(d) { return d.get('reportCount', 0); }
      function validTeam() {
        return team().keys().hasOnly(['ownerUid', 'ownerName', 'ownerKey', 'avatar', 'name', 'color', 'pokemon', 'sets',
                                      'ratingSum', 'ratingCount', 'reportCount', 'updatedAt'])
          // dados completos de cada Pokémon (golpes, item, EVs...): 6 posições
          && (!('sets' in team()) || (team().sets is list && team().sets.size() == 6))
          && team().ownerUid == request.auth.uid
          && team().ownerName == accountName(request.auth.uid)
          && team().ownerKey == keyOf(team().ownerName)
          && team().name is string && team().name.size() <= 60
          && team().pokemon is list && team().pokemon.size() == 6
          && (team().color == null || team().color is string)
          && validAvatar(team());
      }
      allow read: if request.auth != null;
      allow create: if validTeam() && team().ratingSum == 0 && team().ratingCount == 0 && reports(team()) == 0;
      allow update: if (
          // dono: muda o time, mas não a nota nem as denúncias
          resource.data.ownerUid == request.auth.uid && validTeam()
            && team().ratingSum == resource.data.ratingSum && team().ratingCount == resource.data.ratingCount
            && reports(team()) == reports(resource.data)
        ) || (
          // outra pessoa denuncia: +1 denúncia, junto com a própria (uma por pessoa)
          request.auth != null && resource.data.ownerUid != request.auth.uid
            && team().diff(resource.data).affectedKeys().hasOnly(['reportCount'])
            && !exists(reportPath()) && existsAfter(reportPath())
            && team().reportCount == reports(resource.data) + 1
        ) || (
          // outra pessoa: só a nota, junto com o próprio voto
          request.auth != null && resource.data.ownerUid != request.auth.uid
            && team().diff(resource.data).affectedKeys().hasOnly(['ratingSum', 'ratingCount'])
            && existsAfter(ratingPath())
            && team().ratingSum == resource.data.ratingSum + getAfter(ratingPath()).data.stars
                 - (exists(ratingPath()) ? get(ratingPath()).data.stars : 0)
            && team().ratingCount == resource.data.ratingCount + (exists(ratingPath()) ? 0 : 1)
        ) || (
          // outra pessoa tira a própria denúncia (ao excluir a conta): -1 denúncia
          request.auth != null && resource.data.ownerUid != request.auth.uid
            && team().diff(resource.data).affectedKeys().hasOnly(['reportCount'])
            && exists(reportPath()) && !existsAfter(reportPath())
            && team().reportCount == reports(resource.data) - 1
        ) || (
          // outra pessoa tira o próprio voto (ao excluir a conta): a nota volta
          request.auth != null && resource.data.ownerUid != request.auth.uid
            && team().diff(resource.data).affectedKeys().hasOnly(['ratingSum', 'ratingCount'])
            && exists(ratingPath()) && !existsAfter(ratingPath())
            && team().ratingSum == resource.data.ratingSum - get(ratingPath()).data.stars
            && team().ratingCount == resource.data.ratingCount - 1
        );
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      // Denúncia (uma por pessoa), sempre junto com o +1 no time. Com 3 ou mais
      // o time some da busca; o dono do projeto revisa no Console do Firebase.
      match /reports/{uid} {
        function parent() { return /databases/$(database)/documents/publicTeams/$(teamId); }
        function ownerOfTeam() {
          return request.auth != null && get(parent()).data.ownerUid == request.auth.uid;
        }
        allow read: if signedIn(uid) || ownerOfTeam();
        // Quem denunciou apaga a própria denúncia ao excluir a conta, sempre
        // junto com o -1 no time; o dono apaga todas ao excluir o time.
        allow delete: if (signedIn(uid) && (
            !exists(parent())
            || getAfter(parent()).data.get('reportCount', 0) == get(parent()).data.get('reportCount', 0) - 1
          )) || ownerOfTeam();
        allow create: if signedIn(uid)
          && request.resource.data.keys().hasOnly(['reason', 'createdAt'])
          && request.resource.data.reason is string && request.resource.data.reason.size() <= 200
          && get(parent()).data.ownerUid != uid
          && getAfter(parent()).data.get('reportCount', 0) == get(parent()).data.get('reportCount', 0) + 1;
      }

      // Voto de cada pessoa (1 a 5 estrelas), sempre junto com a nota do time.
      match /ratings/{uid} {
        function parent() { return /databases/$(database)/documents/publicTeams/$(teamId); }
        function ownerOfTeam() {
          return request.auth != null && get(parent()).data.ownerUid == request.auth.uid;
        }
        allow read: if signedIn(uid) || ownerOfTeam();
        // Tirar o voto (ao excluir a conta): sempre junto com a nota do time
        // voltando. O dono apaga todos os votos ao excluir o time.
        allow delete: if (signedIn(uid) && (
            !exists(parent())
            || (getAfter(parent()).data.ratingSum == get(parent()).data.ratingSum - resource.data.stars
                && getAfter(parent()).data.ratingCount == get(parent()).data.ratingCount - 1)
          )) || ownerOfTeam();
        allow create, update: if signedIn(uid)
          && request.resource.data.keys().hasOnly(['stars'])
          && request.resource.data.stars is int
          && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
          && get(parent()).data.ownerUid != uid
          && getAfter(parent()).data.ratingSum == get(parent()).data.ratingSum + request.resource.data.stars
               - (resource == null ? 0 : resource.data.stars)
          && getAfter(parent()).data.ratingCount == get(parent()).data.ratingCount + (resource == null ? 1 : 0);
      }
    }

    // Nomes já usados. Qualquer um pode conferir UM nome (para avisar que já
    // existe), mas não dá para listar todos. Só dá para reservar um nome
    // livre, para si mesmo, e a chave precisa ser a do próprio nome.
    // Assim não existem 2 pessoas com o mesmo nome.
    match /usernames/{key} {
      // Nome de uma conta que já foi excluída (o perfil não existe mais):
      // fica livre para quem quiser usar.
      function orphanName() {
        return !exists(/databases/$(database)/documents/users/$(resource.data.uid));
      }
      allow get: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 20
        && keyOf(request.resource.data.name) == key;
      allow update: if request.auth != null
        && (resource.data.uid == request.auth.uid || orphanName())
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name'])
        && keyOf(request.resource.data.name) == key;
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || orphanName());
    }
  }
}
