rules_version = '2';

// Regras do banco de dados dos usuários do PocketDex (site e app).
// Cole no Console do Firebase → Firestore Database → Regras → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil e dados (favoritos, times, treinos...) de cada pessoa:
    // só ela mesma pode ler e escrever.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Ranking do modo Ranked do jogo: todos os logados veem; cada pessoa só
    // escreve a própria linha, com o nome da conta dela.
    match /ranking/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'score', 'updatedAt'])
        && request.resource.data.score is int
        && request.resource.data.score > 0
        && request.resource.data.score <= 5000
        && request.resource.data.name == get(/databases/$(database)/documents/users/$(uid)).data.name;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Nomes já usados. Qualquer um pode conferir UM nome (para avisar que já
    // existe), mas não dá para listar todos. Só dá para reservar um nome
    // livre, para si mesmo. Assim não existem 2 pessoas com o mesmo nome.
    match /usernames/{name} {
      allow get: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 20;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
